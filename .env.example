# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube a Git.

# Carpeta de la wallet de Oracle (usar / en vez de \)
WALLET_DIR=C:/wallets/Wallet_XXXXXXXX

# Credenciales de Oracle.
# Si ya existen como variables de entorno de Windows, se pueden dejar vacías:
# Compose usa primero las variables del sistema.
DB_USER=
DB_PASSWORD=